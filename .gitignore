# In-project Poetry virtualenv
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Generated pipeline runs (every per-app, per-run output dir — timestamped
# AND named runs). The app-level contract files (apps/<app_id>/app.yaml,
# customization.yaml, *_customization.yaml) stay tracked; only the run
# subdirectories one level deeper are ignored.
apps/*/*/

# ...except the prefill seed set, which is an app-level INPUT rather than a
# produced run: checked-in demo imagery, one folder per declared category,
# that scripts/prefill_images seeds missing image slots from. It has to be
# tracked for the same reason app.yaml is — a fresh clone that lacks it
# cannot prefill, and the whole point of vendoring the bytes was that they
# stop depending on a third-party host being up.
!apps/*/prefill/
!apps/*/prefill/**

# Local dev secrets (never commit)
.env

# The studio app's local state: one append-only run log per launch
# (.studio/runs/<run_id>.jsonl) and the briefs the form commits
# (.studio/briefs/<slug>.yaml). Machine-local, never shared.
.studio/

# Vendored ColorMcp source is committed; build outputs are regenerated
vendor/colormcp/node_modules/
vendor/colormcp/dist/

assets/**/*
