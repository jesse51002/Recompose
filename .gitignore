# In-project Poetry virtualenv
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Generated pipeline runs (every per-app, per-run output dir — timestamped
# AND named runs). The app-level contract files (apps/<app_id>/app.yaml,
# customization.yaml, *_customization.yaml) stay tracked; only the run
# subdirectories one level deeper are ignored.
apps/*/*/

# ...except the prefill seed set, which is an app-level INPUT rather than a
# produced run: checked-in demo imagery, one folder per declared category,
# that scripts/prefill_images seeds missing image slots from. It has to be
# tracked for the same reason app.yaml is — a fresh clone that lacks it
# cannot prefill, and the whole point of vendoring the bytes was that they
# stop depending on a third-party host being up.
!apps/*/prefill/
!apps/*/prefill/**

# Local dev secrets (never commit)
.env

# The studio app's local state: one append-only run log per launch
# (.studio/runs/<run_id>.jsonl) and the briefs the form commits
# (.studio/briefs/<slug>.yaml). Machine-local, never shared.
.studio/

# Vendored ColorMcp source is committed; build outputs are regenerated
vendor/colormcp/node_modules/
vendor/colormcp/dist/

assets/**/*
.gstack/

# Generated design folders. The studio copies an authored mock app into one of
# these per layout generation, and a layout agent edits it in place. Each is a
# produced artifact, not source; the undo is `rm -rf`.
#
# A PREFIX rather than an ignore-everything-then-un-ignore-the-real-ones rule:
# that shape needs a new negation for every authored app — combatden, zenbjj,
# romanahouse and whatever comes next — and its failure mode is a real app
# silently vanishing from git.
JsxMockUps/src/apps/gen-*/

# npm lockfiles. Untracked deliberately, and consistently: two of three
# packages carrying one reads as a decision nobody made. If lockfiles are
# wanted, add all three in one change rather than letting an `npm install`
# commit them one at a time.
package-lock.json

# Obsidian per-machine UI state (pane layout, open tabs) — churns constantly
docs/.obsidian/workspace.json

# Obsidian only ever opens docs/ as a vault. A .obsidian/ at the repo root
# means something opened the whole repo by mistake -- never commit it.
/.obsidian/
