# Project-local gbrain. GBRAIN_HOME is a PARENT dir -- gbrain appends .gbrain
# itself, so this resolves to Recompose/.gbrain. Without it the CLI looks in
# ~/.gbrain, the global brain shared with every other project.
# shared with every other project. Pointing it here keeps this vault's index
# with the vault.
#
# If GBRAIN_HOME is unset, gbrain reports "No brain configured" rather than
# silently querying a different brain — a loud failure, which is the point.
export GBRAIN_HOME="$PWD"
