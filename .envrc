# Project-local gbrain, always the main checkout's.
#
# GBRAIN_HOME is a PARENT dir — gbrain appends `.gbrain` itself, so this
# resolves to <main>/.gbrain. Derived from git rather than $PWD so a worktree
# gets the same brain as main without a symlink: --git-common-dir is the shared
# .git, and its parent is the main checkout.
#
# One brain, one location. A worktree can query it; the vault is only ever
# edited in main, so the index and the vault never disagree.
export GBRAIN_HOME="$(cd "$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")" && pwd)"
